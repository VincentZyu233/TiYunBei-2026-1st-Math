// ---------------- 第 10 题 ----------------
#import "../_template.typ": *
#import "../_figs.typ": *

#qhead(10, pts: 6)
设函数 $f(x) = x^3 - 3x + 1$，则（    ）

#opts(
  columns: 2,
  (
    [A．$x = -1$ 为 $f(x)$ 的一个极小值点],
    [B．$f(x)$ 在区间 $(-1, 1)$ 上单调递减],
    [C．当 $0 < x < 1$ 时，$-1 < f(2x - 1) < 3$],
    [D．当 $x < 1$ 时，$f(2 - x) < f(x)$],
  ),
)

#sol[
  对函数求导得 $f'(x) = 3x^2 - 3 = 3(x + 1)(x - 1)$。

  令 $f'(x) = 0$，解得驻点 $x_1 = -1$ 与 $x_2 = 1$。
  - 当 $x in (-oo, -1)$ 时，$f'(x) > 0$，$f(x)$ 单调递增；
  - 当 $x in (-1, 1)$ 时，$f'(x) < 0$，$f(x)$ 单调递减；
  - 当 $x in (1, +oo)$ 时，$f'(x) > 0$，$f(x)$ 单调递增。

  对于 A：由单调性可知，$x = -1$ 处由增转减，为 $f(x)$ 的极大值点，极大值为 $f(-1) = (-1)^3 - 3(-1) + 1 = 3$；$x = 1$ 为极小值点，极小值为 $f(1) = 1^3 - 3 + 1 = -1$。故 A 错误。

  对于 B：在区间 $(-1, 1)$ 内恒有 $f'(x) < 0$，故 $f(x)$ 在区间 $(-1, 1)$ 上单调递减，B 正确。

  对于 C：令 $t = 2x - 1$。因为 $0 < x < 1$，所以 $-1 < 2x - 1 < 1$，即 $t in (-1, 1)$。
  由于 $f(t)$ 在 $(-1, 1)$ 上严格单调递减，因此
  $ f(1) < f(t) < f(-1) implies -1 < f(2x - 1) < 3, $
  故 C 正确。

  对于 D：令 $u = 1 - x$。因为 $x < 1$，所以 $u > 0$。注意到 $x = 1 - u$，$2 - x = 1 + u$。
  分别计算 $f(1 + u)$ 与 $f(1 - u)$：
  $ f(1 + u) &= (1 + u)^3 - 3(1 + u) + 1 = 1 + 3u + 3u^2 + u^3 - 3 - 3u + 1 = u^3 + 3u^2 - 1, \
    f(1 - u) &= (1 - u)^3 - 3(1 - u) + 1 = 1 - 3u + 3u^2 - u^3 - 3 + 3u + 1 = -u^3 + 3u^2 - 1. $
  两式作差得
  $ f(2 - x) - f(x) = f(1 + u) - f(1 - u) = 2u^3 = 2(1 - x)^3. $
  当 $x < 1$ 时，$1 - x > 0$，故 $2(1 - x)^3 > 0$，即 $f(2 - x) > f(x)$。
  （亦可取特值检验：令 $x = 0 < 1$，则 $f(2 - 0) = f(2) = 2^3 - 3 times 2 + 1 = 3$，$f(0) = 1$。显然 $f(2) > f(0)$，与选项矛盾。）
  故 D 错误。
]
#ans[选 #text(weight: "bold")[BC]]

#fcap(
  scale: 0.65,
  caption: [第 10 题  函数 $f(x) = x^3 - 3x + 1$ 的图像与单调性：极大值 $(-1, 3)$，极小值 $(1, -1)$],
  {
    axes(-2.4, 2.4, -1.6, 3.5, xl: [$x$], yl: [$y$])
    // 刻度
    for k in (-2, -1, 1, 2) {
      ln((k * 1.0, -0.08), (k * 1.0, 0.08), stroke: s(black, th: 0.5pt))
      txt((k * 1.0, -0.13), anchor: "north", tsize: 0.13, [$#k$])
    }
    for k in (-1, 1, 2, 3) {
      ln((-0.08, k * 1.0), (0.08, k * 1.0), stroke: s(black, th: 0.5pt))
      txt((-0.13, k * 1.0), anchor: "east", tsize: 0.13, [$#k$])
    }
    txt((-0.12, -0.12), anchor: "north-east", tsize: 0.13, [$O$])

    // f(x) = x^3 - 3x + 1
    plot(val => val * val * val - 3.0 * val + 1.0, -2.15, 2.15, stroke: s(blue, th: 1.2pt))

    // 单调递减区间高亮
    plot(val => val * val * val - 3.0 * val + 1.0, -1.0, 1.0, stroke: s(red, th: 2.0pt))

    // 驻点与拐点
    dashed((-1.0, 0.0), (-1.0, 3.0))
    dashed((0.0, 3.0), (-1.0, 3.0))
    pt((-1.0, 3.0), label: [极大值 $(-1, 3)$], r: 0.06, fill: red, dx: -0.1, dy: 0.1, anchor: "south-east")

    dashed((1.0, 0.0), (1.0, -1.0))
    dashed((0.0, -1.0), (1.0, -1.0))
    pt((1.0, -1.0), label: [极小值 $(1, -1)$], r: 0.06, fill: red, dx: 0.1, dy: -0.1, anchor: "north-west")

    pt((0.0, 1.0), label: [拐点 $(0, 1)$], r: 0.05, fill: purple, dx: 0.1, dy: 0.1, anchor: "south-west")

    txt((0.3, 2.8), anchor: "west", tsize: 0.14, text(fill: blue)[$f(x) = x^3 - 3x + 1$])
    txt((0.15, 0.3), anchor: "west", tsize: 0.13, text(fill: red)[$(-1, 1)$ 单调递减])
  },
)
