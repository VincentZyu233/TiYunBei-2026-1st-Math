// ============================================================
//  第 7 题 —— 一、选择题（第 1—8 题）
// ============================================================
#import "../_template.typ": *
#import "../_figs.typ": *

// ---------------- 第 7 题 ----------------
#qhead(7, pts: 5)
已知定义在 $RR$ 上的奇函数 $f(x)$ 在 $(-oo, 0)$ 上单调递增，且 $f(3) = 0$，
则满足 $x f(x + 1) >= 0$ 的 $x$ 的取值范围为（    ）

#opts((
  [A．$(-oo, -2] ∪ [0, 1] ∪ [4, +oo)$],
  [B．$(-oo, -4] ∪ {0} ∪ [2, +oo)$],
  [C．$(-oo, -4] ∪ [-1, 0] ∪ [2, +oo)$],
  [D．$[-4, -1] ∪ [0, 2)$],
), columns: 2)

#sol[
  由奇函数定义 $f(-x) = -f(x)$。

  *关于单调性*：设 $0 < x_1 < x_2$，则 $-x_2 < -x_1 < 0$。由 $f$ 在 $(-oo, 0)$ 上递增，
  $f(-x_2) < f(-x_1)$，即 $-f(x_2) < -f(x_1)$，故 $f(x_2) > f(x_1)$。
  所以 $f$ 在 $(0, +oo)$ 上也单调递增。

  *关于零点*：$f(3) = 0$，由奇性 $f(-3) = -f(3) = 0$。结合 $f$ 在 $(0, +oo)$ 递增，得
  $
    f(t) > 0 ⟺ t ∈ (-3,\, 3), quad quad f(t) < 0 ⟺ t ∈ (-oo, -3) ∪ (3,\, +oo),
  $

  *解不等式*：$x f(x + 1) >= 0$ 要求 $x$ 与 $f(x+1)$ 同号（或其中之一为零）。

  #set text(size: 9.5pt)
  #table(
    columns: (auto, auto, 1fr),
    inset: (x: 4pt, y: 2.5pt),
    align: left,
    stroke: (x, y) => s(rgb("#dddddd"), th: 0.4pt),
    fill: (x, y) => if y == 0 { rgb("#f7f9fc") },
    table.header([$x$], [$x + 1$], [符号判断]),
    [$x < -4$], [$x + 1 < -3$], [$f(x+1) < 0$ 且 $x < 0$，同号，成立],
    [$x = -4$], [$x + 1 = -3$], [$f(x+1) = f(-3) = 0$，成立],
    [$(-4, -1)$], [$(-3, 0)$], [$f(x+1) > 0$ 而 $x < 0$，异号，不成立],
    [$x = -1$], [$x + 1 = 0$], [$x f(0) = -f(0) = 0$，成立],
    [$(0, 2)$], [$(0, 3)$], [$f(x+1) > 0$ 而 $x > 0$，同号，成立],
    [$x = 2$], [$x + 1 = 3$], [$f(x+1) = f(3) = 0$，成立],
    [$x > 2$], [$x + 1 > 3$], [$f(x+1) < 0$ 而 $x > 0$，异号，不成立],
  )
  #set text(size: 10.5pt)

  合并得 $x ∈ (-oo, -4] ∪ [-1, 0] ∪ [2, +oo)$。
]
#ans[$(-oo, -4] ∪ [-1, 0] ∪ [2, +oo)$，选 #text(weight: "bold")[C]]

#fcap(
  scale: 0.95,
  caption: [第 7 题  奇函数零点为 $±3$：$f > 0$ 在 $(-3, 3)$，$f < 0$ 在 $(-oo, -3) ∪ (3, +oo)$],
  {
    plot(
      t => if t < 0.0 { -1.1 * (t + 3.0) - 0.5 * t * t } else { 1.1 * (t - 3.0) + 0.5 * t * t },
      -5.2,
      5.2,
      stroke: s(blue, th: 1.3pt),
    )
    ln((-5.5, 0.0), (5.5, 0.0), stroke: s(black, th: 0.7pt))
    ln((0.0, -4.3), (0.0, 4.3), stroke: s(black, th: 0.7pt))
    txt((5.6, 0.0), anchor: "west", dx: 0.05, [$x$])
    txt((0.0, 4.4), anchor: "south", [$y$])
    pt((-3.0, 0.0), label: [$-3$], r: 0.06, fill: red, anchor: "north", dy: -0.07, tsize: 0.14)
    pt((3.0, 0.0), label: [$3$], r: 0.06, fill: red, anchor: "north", dy: -0.07, tsize: 0.14)
    txt((0.0, 3.4), [$f > 0$])
    txt((-4.4, -2.1), [$f < 0$])
    txt((4.4, -2.1), [$f < 0$])
  },
)
