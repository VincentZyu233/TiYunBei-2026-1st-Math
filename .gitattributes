# 默认按文本自动处理
* text=auto

# ---- 源码 ----
*.py           text diff=python eol=lf
*.typ          text eol=lf
*.lean         text diff=lean eol=lf
*.md           text eol=lf
*.txt          text eol=lf
*.gitignore    text eol=lf
*.gitattributes text eol=lf

# ---- 文本型资源 ----
*.svg          text eol=lf

# ---- 二进制资源 ----
*.pdf    binary
*.png    binary
*.jpg    binary
*.jpeg   binary
*.ttf    binary
*.otf    binary
*.ttc    binary
*.woff   binary
*.woff2  binary

# ---- GitHub 语言统计 (Linguist) ----
lean/**/*.lean     linguist-detectable=true linguist-language=Lean
site/svg/**        linguist-generated=true
site/pdf/**        linguist-generated=true
site/assets/**     linguist-vendored=true
site/manifest.json linguist-generated=true