  "problemSummary": "设复数 z₁ = 3 + i, z₂ = 1 - 3i，严格代数推导除法分母有理化过程，验证 z₁/z₂ = i。",
  "codeLines": [
    "import Mathlib.Data.Complex.Basic",
    "",
    "open Complex",
    "",
    "theorem q09_complex_div :",
    "    ((3 : ℂ) + I) / (1 - 3 * I) = I := by",
    "  have h_denom : (1 - 3 * I) * (1 + 3 * I) = 10 := by",
    "    calc (1 - 3 * I) * (1 + 3 * I)",
    "      _ = 1 - (3 * I) ^ 2 := by ring",
    "      _ = 1 - 9 * I ^ 2 := by ring",
    "      _ = 1 - 9 * (-1) := by rw [I_sq]",
    "      _ = 10 := by norm_num",
    "  have h_numer : ((3 : ℂ) + I) * (1 + 3 * I) = 10 * I := by",
    "    calc ((3 : ℂ) + I) * (1 + 3 * I)",
    "      _ = 3 + 9 * I + I + 3 * I ^ 2 := by ring",
    "      _ = 3 + 10 * I + 3 * (-1) := by rw [I_sq]; ring",
    "      _ = 10 * I := by ring",
    "  have h_div : ((3 : ℂ) + I) / (1 - 3 * I) = (((3 : ℂ) + I) * (1 + 3 * I)) / ((1 - 3 * I) * (1 + 3 * I)) := by",
    "    have h_ne : 1 + 3 * I ≠ 0 := by intro h; apply_fun Complex.re at h; simp at h",
    "    exact mul_div_mul_right ((3 : ℂ) + I) (1 - 3 * I) h_ne |>.symm",
    "  rw [h_div, h_numer, h_denom]",
    "  calc (10 * I) / 10",
    "    _ = (10 / 10 : ℂ) * I := by ring",
    "    _ = 1 * I := by norm_num",
    "    _ = I := by ring"
  ],
